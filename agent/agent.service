[Unit]
Description=Linux Access Control Hub Agent
After=network-online.target firewalld.service NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/linux-access-control-hub
Environment="AGENT_TOKEN=CHANGE_ME_TO_STRONG_RANDOM_TOKEN"
Environment="AGENT_MOCK=0"
Environment="PROTECTED_PORTS=22,8754"
ExecStart=/opt/linux-access-control-hub/.venv/bin/python -m uvicorn agent.main:app --host 0.0.0.0 --port 8754
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
